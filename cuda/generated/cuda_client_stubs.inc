    in.put_u64(reinterpret_cast<uint64_t>(stream));
    in.put_u64(reinterpret_cast<uint64_t>(event));
    in.put(&flags, 4);
    return static_cast<cudaError_t>(tuna::cudart::Post(kApi_cudaStreamWaitEvent, in));
}
