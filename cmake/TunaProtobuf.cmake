# Shared protobuf setup for tuna-guest-agent and tuna-server.
#
# Provides:
#   protobuf::protoc / protobuf::libprotobuf
#   tuna_proto  - static library generated from proto/tuna_frames.proto
#                 (Track B: the driver-API remoting wire protocol)
#   TUNA_PROTO_ROOT - the shared proto/ directory (also holds Track A's
#                     tuna/v1/workload.proto, generated by its own consumers)
#
# Where protobuf comes from: a gRPC build (Track A) links the system/vcpkg
# protobuf that gRPC was built against. Also linking a FetchContent copy into
# the same binary would be an ODR violation, so callers set
# TUNA_SYSTEM_PROTOBUF=ON whenever gRPC is in the build. Without gRPC we fetch a
# pinned protobuf so a bare Windows/MinGW checkout still builds.
#
# include_guard: in the guest-agent superbuild the server project includes
# this file a second time; the first include's targets are reused.
include_guard(GLOBAL)

set(TUNA_PROTO_ROOT "${CMAKE_CURRENT_LIST_DIR}/../proto")
cmake_path(NORMAL_PATH TUNA_PROTO_ROOT)

if(TUNA_SYSTEM_PROTOBUF)
    find_package(Protobuf REQUIRED)
else()
    include(FetchContent)
    FetchContent_Declare(
        protobuf
        GIT_REPOSITORY https://github.com/protocolbuffers/protobuf.git
        GIT_TAG v21.12
        GIT_SHALLOW TRUE
    )
    set(protobuf_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(protobuf_INSTALL OFF CACHE BOOL "" FORCE)
    set(protobuf_MSVC_STATIC_RUNTIME OFF CACHE BOOL "" FORCE)
    FetchContent_MakeAvailable(protobuf)
endif()

set(TUNA_FRAMES_GEN_DIR "${CMAKE_BINARY_DIR}/generated/frames")
file(MAKE_DIRECTORY "${TUNA_FRAMES_GEN_DIR}")

add_custom_command(
    OUTPUT "${TUNA_FRAMES_GEN_DIR}/tuna_frames.pb.cc" "${TUNA_FRAMES_GEN_DIR}/tuna_frames.pb.h"
    COMMAND $<TARGET_FILE:protobuf::protoc>
        --cpp_out=${TUNA_FRAMES_GEN_DIR}
        -I ${TUNA_PROTO_ROOT}
        ${TUNA_PROTO_ROOT}/tuna_frames.proto
    DEPENDS "${TUNA_PROTO_ROOT}/tuna_frames.proto" protobuf::protoc
    COMMENT "Generating C++ sources from tuna_frames.proto"
    VERBATIM
)

add_library(tuna_proto STATIC
    "${TUNA_FRAMES_GEN_DIR}/tuna_frames.pb.cc"
    "${TUNA_FRAMES_GEN_DIR}/tuna_frames.pb.h"
)
target_include_directories(tuna_proto PUBLIC "${TUNA_FRAMES_GEN_DIR}")
target_link_libraries(tuna_proto PUBLIC protobuf::libprotobuf)
